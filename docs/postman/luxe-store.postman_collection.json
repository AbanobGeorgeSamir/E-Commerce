    {
      "name": "Checkout and orders",
      "item": [
        {
          "name": "Place order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"+20 100 000 0000\",\n  \"street\": \"1 Main Street\",\n  \"city\": \"Cairo\",\n  \"zip\": \"11511\",\n  \"items\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"receiptImage\": \"data:image/png;base64,<BASE64_IMAGE_UP_TO_2MB>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The receipt must be a PNG, JPEG, WebP or AVIF data URL of at most 2 MB. Items accept 1 to 100 units per product."
          }
        },
