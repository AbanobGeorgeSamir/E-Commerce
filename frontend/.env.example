# All VITE_ values are embedded into the browser build. Never put secrets here.
# Use the deployed backend URL in Vercel. The /api suffix is required.
VITE_API_URL=
# Backend asset base URL, without the /api suffix.
VITE_ASSET_URL=
# Public canonical URL used for SEO metadata, without a trailing slash.
VITE_APP_URL=
VITE_APP_NAME=Luxe Store
VITE_API_TIMEOUT=10000
VITE_API_WITH_CREDENTIALS=true
